{% assign badge_name = include.badge %}
{% if badge_name %}
  <div class="venue-badge">
    {%- if site.data.venues[badge_name] -%}
      {% assign venue_style = null %}
      {% if site.data.venues[badge_name].color != blank %}
        {% assign venue_style = site.data.venues[badge_name].color | prepend: 'style="background-color:' | append: '"' %}
      {% endif %}
      <abbr class="badge rounded w-100" {% if venue_style %}{{ venue_style }}{% endif %}>
        {% if site.data.venues[badge_name].url %}
          <a href="{{ site.data.venues[badge_name].url }}">{{ badge_name }}</a>
        {% else %}
          <div>{{ badge_name }}</div>
        {% endif %}
      </abbr>
    {%- else -%}
      <abbr class="badge rounded w-100">{{ badge_name }}</abbr>
    {%- endif -%}
  </div>
{% endif %}